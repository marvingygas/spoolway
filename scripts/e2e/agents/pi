#!/bin/sh
# The local worker, standing in.
#
# What it does is decided by the task id, or by an override a scenario writes
# into the ctl directory mid-run. Everything it needs arrives in the
# environment — see `install_mock_agents` in ../agent-mock.sh — so this is an
# ordinary file that `shellcheck` can read and a person can edit, rather than
# shell generated by shell.
set -u

E2E_CTL=${E2E_CTL:-}
E2E_SOLUTIONS=${E2E_SOLUTIONS:-}
E2E_FIXTURE_TEST=${E2E_FIXTURE_TEST:-}
E2E_FIXTURE_VERIFY=${E2E_FIXTURE_VERIFY:-}
E2E_FORGE=${E2E_FORGE_DIR:-}
SPOOLWAY=${E2E_SPOOLWAY:-spoolway}

# The profile's own environment, echoed rather than used: the env table of an
# agent profile is a setting whose only observable is a variable arriving in a
# lane, and a stand-in that never mentioned it would leave it untestable.
echo "lane env: MARK=${MARK:-}"
# The opening prompt is a lane's last argument, and it is where the domain
# documents, the plan and the dependencies a task was pointed at actually
# arrive. Echoed whole, because a suite asserting on any of those has nothing
# else to read.
echo "lane argv: $*"

# Sourced by an absolute path out of the environment, never off `$0`: a lane is
# launched as `pi ...` through PATH, so `$0` is the bare name and `dirname` is
# the *worktree* — which is where a lane's own source lives and where this file
# will never be.
# shellcheck source=transcript.sh
. "$E2E_STANDIN_LIB"
write_transcript pi "$@"

# The task id is a mode of its own, so a scenario names a pathology by what it
# calls its task and overrides it later by writing the ctl file.
#
# Most specific first: a file naming the step beats one naming the task, which
# beats the task id. That is how a scenario says "block at implement once, then
# behave" without having to write the second half mid-run, in a gap between two
# dispatch passes that it does not control.
#
# The step-scoped one is spent as it is read, so it governs one turn and not the
# step forever. A task that blocks and is resumed onto the same step has to find
# it clear the second time — or the resume changed nothing and it blocks again,
# which is a scenario about looping rather than about resuming.
step_ctl="$E2E_CTL/$SPOOLWAY_TASK.$SPOOLWAY_STEP"
mode=$(cat "$step_ctl" 2>/dev/null || true)
[ -n "$mode" ] && rm -f "$step_ctl"
[ -n "$mode" ] || mode=$(cat "$E2E_CTL/$SPOOLWAY_TASK" 2>/dev/null || true)
mode=${mode:-$SPOOLWAY_TASK}

# `linger:<seconds>` is not a pathology and not a mode of its own: it is the
# ordinary turn, held back. A stand-in's whole turn fits inside the launch
# handshake, so a scenario about a lane that is *up but has not reported yet*
# — the dispatcher taken away underneath it, say — is otherwise racing a turn
# measured in milliseconds. Spent like any other step-scoped ctl file, so the
# wait governs one turn and not the step forever.
case "$mode" in
  linger:*)
    sleep "${mode#linger:}"
    mode=$(cat "$E2E_CTL/$SPOOLWAY_TASK" 2>/dev/null || true)
    mode=${mode:-$SPOOLWAY_TASK}
    ;;
esac

# `stage:<step>` is the unblocker that answers `--pass --stage <step>` instead of
# a plain `--pass`. It governs only the lane on `blocked`: every other step of the
# same task takes the ordinary turn, so the task can reach `blocked` at all.
case "$mode" in
  stage:*) [ "$SPOOLWAY_STEP" = blocked ] || mode=$SPOOLWAY_TASK ;;
esac

case "$mode" in
  stage:*) "$SPOOLWAY" report --pass --stage "${mode#stage:}" -m "back to ${mode#stage:}" ;;
  crash) exit 0 ;;          # ends its turn without reporting
  hang | vanish) sleep 300 ;; # never finishes on its own
  # A turn that leaves a change behind and passes. A task cut straight onto
  # `blocked` has never run `implement`, so its branch holds nothing, and the
  # `create-pr` it is sent to would open a pull request for an empty diff.
  # The change keeps such a task shaped like one that ran.
  work) echo "work for $SPOOLWAY_TASK at $SPOOLWAY_STEP" >> "work-$SPOOLWAY_TASK.txt"
        "$SPOOLWAY" report --pass -m "did $SPOOLWAY_STEP, leaving a change" ;;
  bail) "$SPOOLWAY" report --block -m "needs a credential no lane can mint" ;;
  *)
    case "$SPOOLWAY_STEP" in
      implement | fix)
        patch="$E2E_SOLUTIONS/$SPOOLWAY_TASK/$SPOOLWAY_STEP.patch"
        if [ -n "$E2E_SOLUTIONS" ] && [ -f "$patch" ]; then
          # Real work, replayed. The lane is standing in its own worktree, so
          # this lands on the task's branch exactly as an agent's edit would.
          if ! git apply --3way "$patch" >/dev/null 2>&1; then
            "$SPOOLWAY" report --fail -m "the canned patch for $SPOOLWAY_STEP no longer applies"
            exit 0
          fi
          if [ -n "$E2E_FIXTURE_TEST" ] && [ -x "$E2E_FIXTURE_TEST" ]; then
            if ! "$E2E_FIXTURE_TEST" >/dev/null 2>&1; then
              "$SPOOLWAY" report --fail -m "the fixture's own tests are red after $SPOOLWAY_STEP"
              exit 0
            fi
          fi
          "$SPOOLWAY" report --pass -m "applied the canned $SPOOLWAY_STEP patch"
        else
          # A file of the task's own, so parallel tasks never conflict on the
          # merge — conflicts and the refresh step are a scenario of their own,
          # not a side effect every scenario pays.
          echo "work for $SPOOLWAY_TASK at $SPOOLWAY_STEP" >> "work-$SPOOLWAY_TASK.txt"
          "$SPOOLWAY" report --pass -m "did $SPOOLWAY_STEP"
        fi
        ;;
      reproduce)
        # The bugfix pipeline's first visit: capture the bug as a repro. The
        # `norepro` mode is the bug nobody can make happen, which the pipeline
        # must hand to a person rather than loop on.
        if [ "$mode" = norepro ]; then
          "$SPOOLWAY" report --fail -m "the bug will not reproduce: tried what the task describes and saw the documented behaviour"
        else
          echo "exit 1 # the bug, captured" > "repro-$SPOOLWAY_TASK.sh"
          "$SPOOLWAY" report --pass -m "captured the bug as a failing repro"
        fi
        ;;
      reproduce-again)
        # The same visit after the fix, where the repro passing is the pass.
        # `stillbroken` fails exactly once — the sentinel in the ctl directory
        # survives the lane — so the suite can watch the task go back to fix and
        # then land, without steering it mid-run.
        if [ "$mode" = stillbroken ] && [ ! -f "$E2E_CTL/$SPOOLWAY_TASK.retried" ]; then
          touch "$E2E_CTL/$SPOOLWAY_TASK.retried"
          "$SPOOLWAY" report --fail -m "the repro still fails"
        elif [ -f "repro-$SPOOLWAY_TASK.sh" ]; then
          "$SPOOLWAY" report --pass -m "the repro passes now"
        else
          "$SPOOLWAY" report --fail -m "no repro to run: the reproduce step left nothing behind"
        fi
        ;;
      e2e)
        # The one step whose job is to run the project rather than read it. With
        # a fixture that has something to run, run it for real: a lane holding a
        # server, binding a port and reaping it afterwards is the only part of
        # this the pipeline cannot be asked about any other way.
        if [ -n "$E2E_FIXTURE_VERIFY" ] && [ -x "$E2E_FIXTURE_VERIFY" ]; then
          if "$E2E_FIXTURE_VERIFY" "$SPOOLWAY_WORKTREE"; then
            "$SPOOLWAY" report --pass -m "ran it and exercised it"
          else
            "$SPOOLWAY" report --fail -m "the project did not behave when run"
          fi
        else
          "$SPOOLWAY" report --pass -m "nothing to run in this fixture"
        fi
        ;;
      *)
        # The `create-pr` role: the shipped pipelines' last step, and any
        # project pipeline whose last step gives the same job to a prompt.
        # Matched on the prompt this lane runs, which arrives in argv as the
        # profile's `{prompt_file}`.
        #
        # Not on the step id, because that id has been `pr`, then `land`, then
        # `merge`, then `handover`, now `create-pr` — and each time, a stand-in
        # keyed on the name quietly fell through, reported a pass and handed
        # nothing over. The role is what does not drift: handing a change over
        # is this prompt's, whatever its step is called.
        #
        # Which is why this reads the prompt file's *contents* rather than its
        # path. The path used to end in the prompt's own directory and matching
        # `$*` on the name worked; a lane is now handed one composed file per
        # lane, named after the lane, and the same match fell through in exactly
        # the way this comment already warned about. The prompt's own first line
        # survives the composition, and is what a person would read to answer
        # "which role is this".
        # A kind whose prompt travels neither flag — codex's config
        # override — is fronted by a wrapper that read the path out of its
        # own kind's shape and handed it over in `E2E_PROMPT_FILE`.
        prompt=${E2E_PROMPT_FILE:-}
        next=""
        if [ -z "$prompt" ]; then
          for arg in "$@"; do
            [ "$next" = yes ] && { prompt=$arg; next=""; }
            case "$arg" in --append-system-prompt | --append-system-prompt-file) next=yes ;; esac
          done
        fi
        if ! { [ -n "$prompt" ] && [ -f "$prompt" ] && grep -qE "^(You own git\.|# Create PR)" "$prompt"; }; then
          "$SPOOLWAY" report --pass -m "ok"
          exit 0
        fi

        # What it stands in for is the shipped prompt's job: push the branch as
        # it is and open the pull request against the branch the task file
        # names in `starts_from:`, or `base:` where it has none. Never a
        # rebase and never a force-push, as the prompt says — a base that moved
        # under the branch is a non-event, and `conflicts.sh` holds that.
        branch="task/$SPOOLWAY_TASK"
        git rev-parse --verify -q "refs/heads/$branch" >/dev/null 2>&1 \
          || branch=$(git rev-parse --abbrev-ref HEAD)

        onto=$(sed -n "s/^starts_from: //p" "$SPOOLWAY_TASK_FILE" 2>/dev/null | head -1)
        [ -n "$onto" ] || onto=$(sed -n "s/^base: //p" "$SPOOLWAY_TASK_FILE" 2>/dev/null | head -1)

        [ "$mode" = noland ] && {
          "$SPOOLWAY" report --pass -m "left it unpushed on purpose"
          exit 0
        }

        if [ -z "$E2E_FORGE" ]; then
          "$SPOOLWAY" report --pass -m "no forge to open a pull request on"
          exit 0
        fi

        git push -q -u origin "$branch" 2>/dev/null

        # A branch may already have a pull request, and that one is this
        # task's — the double reports "already exists" rather than opening a
        # second.
        "$E2E_FORGE/bin/gh" pr create --head "$branch" --base "${onto:-main}" \
          --title "$SPOOLWAY_TASK" --body "queued by the e2e suite" >/dev/null 2>&1

        # This ends every task's `create-pr`, whatever step reaches it last in
        # its plan: a push and an open pull request, and nothing else. No
        # merge, no plan pull request, no `plan list` — landing is a person's.
        "$SPOOLWAY" report --pass -m "pull request open against \`${onto:-main}\`"
        ;;
    esac
    ;;
esac
